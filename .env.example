APP_NAME="Afrik Appart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Server-side property copy assistant (Groq / OpenAI-compatible API)
GROQ_API_KEY=
PROPERTY_COPY_PROVIDER=groq
PROPERTY_COPY_BASE_URL=https://api.groq.com/openai/v1
PROPERTY_COPY_MODEL=openai/gpt-oss-20b
PROPERTY_COPY_DAILY_LIMIT=10
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5

# Public analytics are disabled until explicitly enabled and consented.
ANALYTICS_ENABLED=false
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# on_premise (default): single tenant, current behaviour. cloud: multi-tenant "Hospitality OS".
PLATFORM_MODE=on_premise
APP_BRAND_NAME="Afrik Appart"

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Required for DatabaseSeeder authentication fixtures. Use unique values outside testing.
SEED_ADMIN_PASSWORD=
SEED_GUEST_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_ERROR_DAILY_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_UPLOAD_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENT_PROVIDER=pay_later
PAYMENT_HOLD_MINUTES=20
# Used by Pay Later, FedaPay sandbox, and FedaPay until provider-native signature verification is configured.
PAYMENT_WEBHOOK_SECRET=
MOBILE_MONEY_PROVIDER=fedapay
# Set production only after real provider credentials are configured.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_BASE_URL=https://api.fedapay.com/v1
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required for PayPal production webhook verification.
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.paypal.com
CINETPAY_ENVIRONMENT=sandbox
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://api.safaricom.co.ke
# Register these provider callbacks after APP_URL is set to your HTTPS domain:
# https://your-domain.example/webhooks/fedapay
# https://your-domain.example/webhooks/paypal
# https://your-domain.example/webhooks/cinetpay
# https://your-domain.example/webhooks/mpesa
APP_PAYMENT_RETURN_URL=http://localhost/payments/return
APP_PAYMENT_CANCEL_URL=http://localhost/payments/cancel
APP_PAYMENT_WEBHOOK_URL=http://localhost/webhooks/payment

VITE_APP_NAME="${APP_NAME}"
