APP_NAME="Afrik Appart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# on_premise (default): single tenant, current behaviour. cloud: multi-tenant "Hospitality OS".
PLATFORM_MODE=on_premise
APP_BRAND_NAME="Afrik Appart"

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Required for DatabaseSeeder authentication fixtures. Use unique values outside testing.
SEED_ADMIN_PASSWORD=
SEED_GUEST_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENT_PROVIDER=pay_later
PAYMENT_HOLD_MINUTES=20
PAYMENT_WEBHOOK_SECRET=
MOBILE_MONEY_PROVIDER=fedapay
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_PAYMENT_RETURN_URL=http://localhost/payments/return
APP_PAYMENT_CANCEL_URL=http://localhost/payments/cancel
APP_PAYMENT_WEBHOOK_URL=http://localhost/webhooks/payment

VITE_APP_NAME="${APP_NAME}"
